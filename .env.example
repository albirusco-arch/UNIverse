# Copy to .env.local for local development. Leave the Supabase values empty to run in demo mode.
# For EAS builds, set the same variables with `npx eas-cli env:create` (preview and production environments).

# Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Shown in Settings → Contact support (required by the App Store)
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: account that signs in with a password, for App Store review
EXPO_PUBLIC_REVIEW_EMAIL=

# Optional: RevenueCat public SDK keys, to sell token packs as in-app purchases
# (RevenueCat → Project → API keys). Without them the Tokens screen shows packs but cannot sell.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
